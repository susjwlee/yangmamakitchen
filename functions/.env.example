# Copy this file to .env (in this same functions/ folder) and fill in real
# values. .env itself is gitignored — it holds real credentials and must
# never be committed or pushed to GitHub.
#
# See README.md → "Setting up order email notifications" for how to get
# a Gmail App Password.

GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16characterapppassword
NOTIFY_EMAIL=whereyouwanttobenotified@gmail.com
